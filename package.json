    "@eslint/js": "^10.0.1",
    "@mikro-orm/cli": "6.4.2",
    "@mikro-orm/knex": "6.4.2",
    "@nestjs/cli": "^10.4.9",
    "@nestjs/testing": "^10.4.15",
    "@types/bun": "^1.4.2",
    "@types/express": "^5.0.6",
    "@types/node": "^22.7.5",
    "ajv": "^8.20.0",
    "ajv-draft-04": "^1.0.0",
    "ajv-formats": "^3.0.1",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.2.1",
    "mikro-orm": "6.4.2",
    "prettier": "^3.3.3",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.11.0"
