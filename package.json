{
  "name": "jungle-wagering-processor",
  "version": "0.1.0",
  "description": "Distributed Wagering Processor — Jungle Gaming Technical Challenge",
  "private": true,
  "scripts": {
    "build": "nest build",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
